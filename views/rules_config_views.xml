<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <!-- FORM VIEW: KETENTUAN & PERATURAN GRADING SALES -->
    <record id="view_sales_grading_rules_config_form" model="ir.ui.view">
        <field name="name">sales.grading.rules.config.form</field>
        <field name="model">sales.grading.rules.config</field>
        <field name="arch" type="xml">
            <form string="Ketentuan &amp; Peraturan Grading Sales">
                <header>
                    <button name="action_apply_and_recalculate"
                            string="Terapkan &amp; Hitung Ulang Semua Grading"
                            type="object"
                            class="btn-primary"
                            icon="fa-refresh"
                            groups="sales_grading_triwulan.group_sales_grading_manager,base.group_system"
                            confirm="Apakah Anda yakin ingin menerapkan perubahan ketentuan ini? Semua dokumen Grading Salesman dan Evaluasi Supervisor akan dikalkulasi ulang secara otomatis sesuai regulasi terbaru."/>
                    <button name="action_reset_to_default"
                            string="Reset ke Nilai Standar Default"
                            type="object"
                            class="btn-secondary"
                            icon="fa-undo"
                            groups="sales_grading_triwulan.group_sales_grading_manager,base.group_system"
                            confirm="Kembalikan semua ketentuan ke pengaturan standar awal PT Aston Graphindo Indonesia?"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" style="margin-bottom: 16px;">
                        <h4 style="margin-top: 0; font-size: 15px; font-weight: 700;">
                            <i class="fa fa-info-circle mr-1"/> Pusat Kendali Regulasi Grading Sales
                        </h4>
                        Setiap perubahan nilai batas target, threshold grade, tunjangan, dan regulasi supervisor pada halaman ini akan langsung menjadi acuan kalkulasi matematis di seluruh sistem (Dashboard Salesman, Rekap Grading, dan Dashboard Supervisor).
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Judul Dokumen Regulasi"/>
                        <h1>
                            <field name="name" placeholder="Judul Ketentuan &amp; Peraturan..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Status Regulasi">
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Riwayat Pembaruan">
                            <field name="last_updated" readonly="1"/>
                            <field name="updated_by" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- TAB 1: KETENTUAN GRADE SALESMAN -->
                        <page string="1. Ketentuan Grade Salesman (Tabel B &amp; A)" name="salesman_rules">
                            <div class="alert alert-warning" role="alert" style="margin-top: 8px; margin-bottom: 14px;">
                                <strong>Prinsip Mutlak:</strong>
                                <ul>
                                    <li><strong>Tabel B (Penentu Grade Resmi):</strong> Kolom <em>Min Rata-rata GP / Bulan</em> adalah satu-satunya penentu grade salesman berdasarkan rata-rata pencapaian GP triwulan berjalan.</li>
                                    <li><strong>Tabel A (Target Kinerja &amp; Tunjangan):</strong> Kolom <em>Target GP / Bulan</em> dan <em>Tunjangan Fungsional</em> adalah hak kompensasi dan tolok ukur target bulanan salesman sesuai grade yang disandang.</li>
                                </ul>
                            </div>
                            <field name="salesman_rule_ids">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="sequence" widget="handle"/>
                                    <field name="grade" readonly="1"/>
                                    <field name="name" string="Nama Jabatan / Grade"/>
                                    <field name="min_avg_gp_monthly" string="Min Rata-rata GP (Tabel B)"/>
                                    <field name="target_gp_monthly" string="Target GP/Bln (Tabel A)"/>
                                    <field name="target_gp_quarterly" string="Target GP/TW" readonly="1"/>
                                    <field name="tunjangan_fungsional" string="Tunjangan Fungsional"/>
                                    <field name="gaji_pokok" string="Gaji Pokok"/>
                                    <field name="keterangan" string="Keterangan"/>
                                </tree>
                            </field>
                        </page>

                        <!-- TAB 2: KETENTUAN GRADE SUPERVISOR -->
                        <page string="2. Ketentuan Grade Supervisor (2 Grade)" name="supervisor_rules">
                            <div class="alert alert-primary" role="alert" style="margin-top: 8px; margin-bottom: 14px;">
                                <strong>Struktur Jabatan Supervisor Resmi (2 Grade):</strong>
                                <ul>
                                    <li><strong>Supervisor:</strong> Target GP Rp200 Jt/bln (Rp600 Jt/TW), Komposisi tim 6 - 8 Sales + 1 Spv. Promosi jika 3 triwulan rata-rata &gt;= 100%.</li>
                                    <li><strong>Senior Supervisor:</strong> Target GP Rp300 Jt/bln (Rp900 Jt/TW), Komposisi tim 9 - 11 Sales + 1 Spv. Turun grade jika target &lt; 70% selama 3 triwulan.</li>
                                </ul>
                            </div>
                            <field name="supervisor_rule_ids">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="sequence" widget="handle"/>
                                    <field name="grade" readonly="1"/>
                                    <field name="name" string="Jabatan Supervisor"/>
                                    <field name="target_gp_monthly" string="Target GP / Bulan"/>
                                    <field name="target_gp_triwulan" string="Target GP / Triwulan" readonly="1"/>
                                    <field name="target_gp_annual" string="Target GP / Tahun" readonly="1"/>
                                    <field name="sales_min" string="Min Sales"/>
                                    <field name="sales_max" string="Max Sales"/>
                                    <field name="team_composition" string="Komposisi Tim" readonly="1"/>
                                    <field name="eval_threshold_pct" string="Threshold 3-TW (%)"/>
                                    <field name="eval_rule_description" string="Aturan Evaluasi"/>
                                </tree>
                            </field>
                        </page>

                        <!-- TAB 3: PANDUAN ALUR KERJA & REGULASI RESMI (SOP) -->
                        <page string="3. Alur Kerja &amp; Regulasi Resmi (SOP)" name="workflow_guide">
                            <field name="workflow_guide_html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SERVER ACTION: OPEN KETENTUAN & PERATURAN -->
    <record id="action_sales_grading_rules_config" model="ir.actions.server">
        <field name="name">Ketentuan &amp; Peraturan Grading</field>
        <field name="model_id" ref="model_sales_grading_rules_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_active_config()</field>
    </record>

    </data>
</odoo>
