<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sales_grading_triwulan.RekapSalesman" owl="1">
        <div class="sg-root">
            <t t-if="state.data">
                <div class="sg-header">
                    <div>
                        <h2 class="sg-header-title"><span>📋</span> Rekap Grading Salesman (Histori Triwulan &amp; Tahunan)</h2>
                        <div class="sg-header-sub">
                            PT. Aston Graphindo Indonesia
                        </div>
                    </div>
                    <div class="sg-toolbar-actions">
                        <button class="sg-btn sg-btn-outline" t-on-click="() => this.fetchData()">↻ Refresh</button>
                        <button class="sg-btn sg-btn-excel" t-on-click="() => this.exportFile('xlsx')">📥 Export Excel</button>
                        <button class="sg-btn sg-btn-outline" t-on-click="() => this.exportFile('pdf')">📄 Export PDF</button>
                        <button class="sg-btn sg-btn-outline" t-on-click="() => this.exportFile('html')">🖨️ Print Out</button>
                    </div>
                </div>

                <!-- FILTER BAR -->
                <div class="sg-filter-bar">
                    <div class="sg-filter-item" style="max-width: 240px;">
                        <label>Pencarian Nama / Tim</label>
                        <input type="text" placeholder="Ketik nama salesman..." t-att-value="state.filters.search"
                               t-on-input="(e) => this.onFilterChange('search', e)"/>
                    </div>
                    <div class="sg-filter-item">
                        <label>Tahun</label>
                        <select t-att-value="state.filters.year" t-on-change="(e) => this.onFilterChange('year', e)">
                            <option value="ALL" t-att-selected="state.filters.year === 'ALL'">Semua Tahun (≥ 2026)</option>
                            <t t-foreach="state.data.options.years" t-as="yr" t-key="yr">
                                <option t-att-value="yr" t-att-selected="state.filters.year === yr"><t t-esc="yr"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="sg-filter-item">
                        <label>Triwulan</label>
                        <select t-att-value="state.filters.quarter" t-on-change="(e) => this.onFilterChange('quarter', e)">
                            <option value="ALL" t-att-selected="state.filters.quarter === 'ALL'">Semua Triwulan</option>
                            <t t-foreach="state.data.options.quarters" t-as="q" t-key="q.key">
                                <option t-att-value="q.key" t-att-selected="state.filters.quarter === q.key"><t t-esc="q.label"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="sg-filter-item">
                        <label>Salesman</label>
                        <select t-att-value="state.filters.employee_name" t-on-change="(e) => this.onFilterChange('employee_name', e)">
                            <option value="ALL">Semua Salesman</option>
                            <t t-foreach="state.data.options.salesmen" t-as="sm" t-key="sm">
                                <option t-att-value="sm"><t t-esc="sm"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="sg-filter-item">
                        <label>Tim</label>
                        <select t-att-value="state.filters.team_id" t-on-change="(e) => this.onFilterChange('team_id', e)">
                            <option value="ALL">Semua Tim</option>
                            <t t-foreach="state.data.options.teams" t-as="tm" t-key="tm.id">
                                <option t-att-value="tm.id"><t t-esc="tm.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="sg-filter-item">
                        <label>Potensi Grading TW Berikutnya</label>
                        <select t-att-value="state.filters.grading_terbaru" t-on-change="(e) => this.onFilterChange('grading_terbaru', e)">
                            <option value="ALL">Semua Grade</option>
                            <t t-foreach="state.data.options.grades" t-as="g" t-key="g.key">
                                <option t-att-value="g.key"><t t-esc="g.label"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="sg-filter-item">
                        <label>Status Perubahan</label>
                        <select t-att-value="state.filters.status_perubahan" t-on-change="(e) => this.onFilterChange('status_perubahan', e)">
                            <option value="ALL">Semua Status</option>
                            <t t-foreach="state.data.options.statuses" t-as="st" t-key="st.key">
                                <option t-att-value="st.key"><t t-esc="st.label"/></option>
                            </t>
                        </select>
                    </div>
                </div>

                <!-- REKAP TABLE -->
                <div class="sg-card">
                    <div class="sg-card-header">
                        <h4 class="sg-card-title">Tabel Rekap Grading Salesman (Klik Nama untuk Detail &amp; Rincian Bulanan)</h4>
                        <span style="font-size: 12px; color: #64748b;"><t t-esc="state.data.rows.length"/> baris</span>
                    </div>
                    <div class="sg-table-wrap">
                        <table class="sg-table">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th class="sortable" t-on-click="() => this.toggleSort('year')">Tahun ⇅</th>
                                    <th>Triwulan</th>
                                    <th class="sortable" t-on-click="() => this.toggleSort('employee_name')">Nama Salesman ⇅</th>
                                    <th>Tim</th>
                                    <th>Grading Sekarang</th>
                                    <th>Potensi Grading TW Berikutnya</th>
                                    <th class="text-end sortable" t-on-click="() => this.toggleSort('total_gp')">Total GP 3 Bln ⇅</th>
                                    <th class="text-end sortable" t-on-click="() => this.toggleSort('rata_rata_gp')">Rata-rata GP/Bln ⇅</th>
                                    <th class="text-end">Target GP/Bln</th>
                                    <th class="sortable" t-on-click="() => this.toggleSort('persentase_pencapaian')">% Pencapaian ⇅</th>
                                    <th>Status Perubahan</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.data.rows" t-as="r" t-key="r.id">
                                    <td><t t-esc="r.no"/></td>
                                    <td><t t-esc="r.year"/></td>
                                    <td><t t-esc="r.quarter_label"/></td>
                                    <td>
                                        <a class="sg-link-name" t-on-click="() => this.openDetail(r)">
                                            <t t-esc="r.employee_name"/>
                                        </a>
                                    </td>
                                    <td><t t-esc="r.team_name"/></td>
                                    <td><span t-att-class="gradeClass(r.grading_awal)"><t t-esc="r.grading_awal_label"/></span></td>
                                    <td>
                                        <span t-if="r.is_valid_final" t-att-class="gradeClass(r.grading_terbaru)"><t t-esc="r.grading_terbaru_label"/></span>
                                        <span t-else="" class="sg-badge sg-status-incomplete">Sementara (<t t-esc="r.grading_terbaru_label"/>)</span>
                                    </td>
                                    <td class="text-end fw-bold"><t t-esc="fmtIDR(r.total_gp)"/></td>
                                    <td class="text-end"><t t-esc="fmtIDR(r.rata_rata_gp)"/></td>
                                    <td class="text-end"><t t-esc="fmtIDR(r.target_gp_bulanan)"/></td>
                                    <td>
                                        <div class="sg-progress-wrap">
                                            <div class="sg-progress-track">
                                                <div t-att-class="progClass(r.persentase_pencapaian)"
                                                     t-attf-style="width: #{Math.min(100, Math.max(0, r.persentase_pencapaian))}%"/>
                                            </div>
                                            <span style="font-weight: 700; min-width: 52px; text-align: right;">
                                                <t t-esc="fmtPct(r.persentase_pencapaian)"/>
                                            </span>
                                        </div>
                                    </td>
                                    <td><span t-att-class="statusClass(r.status_perubahan)"><t t-esc="r.status_perubahan_label"/></span></td>
                                </tr>
                                <tr t-if="!state.data.rows.length">
                                    <td colspan="12" class="text-center" style="padding: 28px; color: #64748b;">
                                        Tidak ada data rekap untuk filter yang dipilih.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

            <t t-if="state.detail">
                <SalesmanDetailModal detail="state.detail" onClose.bind="closeDetail"/>
            </t>
        </div>
    </t>
</templates>
